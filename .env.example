# Keyless local AI (default). Install Ollama, then download the model:
# ollama pull qwen2.5-coder:3b
AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
AI_MODEL=qwen2.5-coder:3b

# Optional hosted provider mode (not needed for local Ollama):
# AI_PROVIDER=openai
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1

# Optional GitHub fine-grained token for repository browsing and approved PRs.
GITHUB_TOKEN=
PORT=8787
HOST=127.0.0.1
CLIENT_ORIGIN=http://localhost:5173