# Required for live AI chat. Keep this file private and never use VITE_ for secrets.
AI_API_KEY=
# OpenAI-compatible endpoint base URL, without /chat/completions
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Optional GitHub fine-grained token. Browsing needs Metadata/Contents: read; approvals need Contents: write and Pull requests: write.
GITHUB_TOKEN=
PORT=8787
HOST=127.0.0.1
CLIENT_ORIGIN=http://localhost:5173